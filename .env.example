DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
# Connexion directe pour les migrations (Neon : DATABASE_URL_UNPOOLED ; en local, la même que DATABASE_URL)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DB"
# Chaîne aléatoire d'au moins 32 caractères (openssl rand -base64 32)
AUTH_SECRET=""
# Compte administrateur créé par le seed
SEED_ADMIN_PHONE="+22900000000"
SEED_ADMIN_PASSWORD="ChangezMoi!2026"

# Notifications (rappels) — générer les clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ebbtanmey@gmail.com"
# Secret de la tâche planifiée qui appelle /api/cron/rappels toutes les 15 minutes
CRON_SECRET=""

# Adresse publique du site, ex. https://ebb-jr-tanmey.org
NEXT_PUBLIC_SITE_URL=""

# Paiements : « simulation » (mode test, aucun argent réel) ou « saaspay » (quand l'intégration sera faite).
# Laisser vide pour désactiver le don en ligne.
PAYMENT_PROVIDER=""
PAYMENT_WEBHOOK_SECRET=""
# Le mode « simulation » est refusé en production sauf si ALLOW_PAYMENT_SIMULATION="true" (recette uniquement)
ALLOW_PAYMENT_SIMULATION=""
SAASPAY_API_URL=""
SAASPAY_API_KEY=""
SAASPAY_SECRET=""
